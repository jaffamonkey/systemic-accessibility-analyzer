{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "SpecA11y",
          "version": "0.5.2",
          "informationUri": "https://github.com/OKlueck/SpecA11y",
          "rules": [
            {
              "id": "img-alt",
              "name": "Images must have alternate text",
              "shortDescription": {
                "text": "Ensures <img> elements have alternative text or are marked as decorative."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "1.1.1",
                    "name": "Non-text Content",
                    "level": "A",
                    "version": "2.0",
                    "principle": "perceivable"
                  }
                ],
                "severity": "critical",
                "confidence": "certain"
              }
            },
            {
              "id": "color-contrast",
              "name": "Elements must have sufficient color contrast",
              "shortDescription": {
                "text": "Ensures text elements have at least a 4.5:1 contrast ratio (3:1 for large text)."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "1.4.3",
                    "name": "Contrast (Minimum)",
                    "level": "AA",
                    "version": "2.0",
                    "principle": "perceivable"
                  }
                ],
                "severity": "serious",
                "confidence": "likely"
              }
            },
            {
              "id": "use-of-color",
              "name": "Color must not be the only visual means of conveying information",
              "shortDescription": {
                "text": "Checks that links and interactive elements are distinguishable from surrounding text by more than just color (e.g. underline, font-weight, border)."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "1.4.1",
                    "name": "Use of Color",
                    "level": "A",
                    "version": "2.0",
                    "principle": "perceivable"
                  }
                ],
                "severity": "moderate",
                "confidence": "possible"
              }
            },
            {
              "id": "video-caption",
              "name": "Video elements must have captions",
              "shortDescription": {
                "text": "Ensures <video> elements have a <track kind=\"captions\"> child for accessibility."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "1.2.2",
                    "name": "Captions (Prerecorded)",
                    "level": "A",
                    "version": "2.0",
                    "principle": "perceivable"
                  }
                ],
                "severity": "critical",
                "confidence": "likely"
              }
            },
            {
              "id": "meaningful-sequence",
              "name": "Content must have a meaningful reading sequence",
              "shortDescription": {
                "text": "Heuristic check that CSS-positioned elements (absolute/fixed) with text content appear in a logical reading order in the DOM."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "1.3.2",
                    "name": "Meaningful Sequence",
                    "level": "A",
                    "version": "2.0",
                    "principle": "perceivable"
                  }
                ],
                "severity": "moderate",
                "confidence": "possible"
              }
            },
            {
              "id": "landmark-unique",
              "name": "Landmarks must have a unique accessible name when multiple of the same role exist",
              "shortDescription": {
                "text": "When multiple landmarks share the same role, each must have a unique accessible name via aria-label or aria-labelledby."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "1.3.1",
                    "name": "Info and Relationships",
                    "level": "A",
                    "version": "2.0",
                    "principle": "perceivable"
                  }
                ],
                "severity": "moderate",
                "confidence": "likely"
              }
            },
            {
              "id": "link-in-text-block",
              "name": "Links in text blocks must be distinguishable by more than color",
              "shortDescription": {
                "text": "Ensures links within blocks of text are visually distinguishable from surrounding text by means other than color alone, such as underline, border, or font-weight change."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "1.4.1",
                    "name": "Use of Color",
                    "level": "A",
                    "version": "2.0",
                    "principle": "perceivable"
                  }
                ],
                "tags": [
                  "best-practice"
                ],
                "severity": "moderate",
                "confidence": "likely"
              }
            },
            {
              "id": "css-content-visibility",
              "name": "Content must not be made invisible via CSS tricks",
              "shortDescription": {
                "text": "Detects CSS properties that make content invisible while keeping it in the DOM: filter opacity below threshold, font-size below 4px, transform scale(0), or clip-path hiding."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "1.4.3",
                    "name": "Contrast (Minimum)",
                    "level": "AA",
                    "version": "2.0",
                    "principle": "perceivable"
                  },
                  {
                    "id": "1.4.4",
                    "name": "Resize Text",
                    "level": "AA",
                    "version": "2.0",
                    "principle": "perceivable"
                  }
                ],
                "severity": "critical",
                "confidence": "certain"
              }
            },
            {
              "id": "transparent-content",
              "name": "Text must not be made invisible via transparent color, low opacity, or extreme spacing",
              "shortDescription": {
                "text": "Detects text elements with color: transparent, rgba with alpha 0, low effective opacity (CSS opacity or filter: opacity()), or extremely negative letter-spacing/word-spacing that makes text unreadable."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "1.4.3",
                    "name": "Contrast (Minimum)",
                    "level": "AA",
                    "version": "2.0",
                    "principle": "perceivable"
                  }
                ],
                "severity": "critical",
                "confidence": "certain"
              }
            },
            {
              "id": "css-text-distortion",
              "name": "Text must not be distorted to be unreadable via CSS",
              "shortDescription": {
                "text": "Detects CSS properties that make text unreadable: extreme rotation (>45°) or direction:rtl with unicode-bidi:bidi-override on Latin text."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "1.4.3",
                    "name": "Contrast (Minimum)",
                    "level": "AA",
                    "version": "2.0",
                    "principle": "perceivable"
                  },
                  {
                    "id": "1.3.2",
                    "name": "Meaningful Sequence",
                    "level": "A",
                    "version": "2.0",
                    "principle": "perceivable"
                  }
                ],
                "severity": "serious",
                "confidence": "likely"
              }
            },
            {
              "id": "frame-title",
              "name": "Frames must have a title attribute",
              "shortDescription": {
                "text": "Ensures <iframe> and <frame> elements have a non-empty title attribute."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "2.4.1",
                    "name": "Bypass Blocks",
                    "level": "A",
                    "version": "2.0",
                    "principle": "operable"
                  }
                ],
                "severity": "serious",
                "confidence": "certain"
              }
            },
            {
              "id": "multiple-ways",
              "name": "Page should provide multiple ways to locate content",
              "shortDescription": {
                "text": "Checks that the page provides at least one of: navigation landmark, search functionality, sitemap link, or table of contents."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "2.4.5",
                    "name": "Multiple Ways",
                    "level": "AA",
                    "version": "2.0",
                    "principle": "operable"
                  }
                ],
                "severity": "moderate",
                "confidence": "possible"
              }
            },
            {
              "id": "skip-link",
              "name": "Page should have a skip navigation link",
              "shortDescription": {
                "text": "Checks if the page has a skip navigation link among the first few focusable elements that points to the main content area."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "2.4.1",
                    "name": "Bypass Blocks",
                    "level": "A",
                    "version": "2.0",
                    "principle": "operable"
                  }
                ],
                "severity": "moderate",
                "confidence": "possible"
              }
            },
            {
              "id": "focus-visible-contrast",
              "name": "Focus indicator should have sufficient contrast",
              "shortDescription": {
                "text": "Checks that focus outline/border color has sufficient contrast against the background, ensuring the focus indicator is actually visible."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "2.4.7",
                    "name": "Focus Visible",
                    "level": "AA",
                    "version": "2.0",
                    "principle": "operable"
                  }
                ],
                "tags": [
                  "semantic",
                  "heuristic"
                ],
                "severity": "serious",
                "confidence": "likely"
              }
            },
            {
              "id": "pointer-interaction-blocked",
              "name": "Content areas must not block pointer interaction",
              "shortDescription": {
                "text": "Detects pointer-events: none and cursor: none on content areas that would prevent mouse/touch interaction."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "2.5.1",
                    "name": "Pointer Gestures",
                    "level": "A",
                    "version": "2.1",
                    "principle": "operable"
                  }
                ],
                "severity": "critical",
                "confidence": "certain"
              }
            },
            {
              "id": "button-name",
              "name": "Buttons must have accessible names",
              "shortDescription": {
                "text": "Ensures every <button> and [role=\"button\"] element has an accessible name via text content, aria-label, aria-labelledby, title, or value."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "4.1.2",
                    "name": "Name, Role, Value",
                    "level": "A",
                    "version": "2.0",
                    "principle": "robust"
                  }
                ],
                "severity": "critical",
                "confidence": "certain"
              }
            },
            {
              "id": "consistent-navigation",
              "name": "Navigation elements should have consistent structure",
              "shortDescription": {
                "text": "Checks that nav elements use a consistent list-based structure with links, which supports predictable navigation for assistive technology users."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "3.2.3",
                    "name": "Consistent Navigation",
                    "level": "AA",
                    "version": "2.0",
                    "principle": "understandable"
                  }
                ],
                "severity": "moderate",
                "confidence": "possible"
              }
            },
            {
              "id": "aria-allowed-attr",
              "name": "ARIA attributes must be allowed for the element role",
              "shortDescription": {
                "text": "Ensures ARIA attributes used on elements are valid for that element's role."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "4.1.2",
                    "name": "Name, Role, Value",
                    "level": "A",
                    "version": "2.0",
                    "principle": "robust"
                  }
                ],
                "severity": "critical",
                "confidence": "certain"
              }
            },
            {
              "id": "aria-required-children",
              "name": "ARIA roles must contain required children",
              "shortDescription": {
                "text": "Ensures elements with ARIA roles that require specific child roles contain at least one child with one of those roles."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "1.3.1",
                    "name": "Info and Relationships",
                    "level": "A",
                    "version": "2.0",
                    "principle": "perceivable"
                  }
                ],
                "severity": "serious",
                "confidence": "certain"
              }
            },
            {
              "id": "aria-hidden-content",
              "name": "aria-hidden must not hide significant visible content",
              "shortDescription": {
                "text": "Ensures aria-hidden=\"true\" is not set on elements that contain significant visible content such as text, images, or form controls."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "4.1.2",
                    "name": "Name, Role, Value",
                    "level": "A",
                    "version": "2.0",
                    "principle": "robust"
                  }
                ],
                "severity": "critical",
                "confidence": "certain"
              }
            },
            {
              "id": "text-spacing",
              "name": "Content must not be clipped when text spacing is increased",
              "shortDescription": {
                "text": "Injects WCAG 1.4.12 text spacing overrides and checks for text overflow or clipping."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "1.4.12",
                    "name": "Text Spacing",
                    "level": "AA",
                    "version": "2.1",
                    "principle": "perceivable"
                  }
                ],
                "severity": "serious",
                "confidence": "likely"
              }
            },
            {
              "id": "reflow",
              "name": "Content must reflow without horizontal scrolling at 320px width",
              "shortDescription": {
                "text": "Resizes the viewport to 320px and checks for elements that cause horizontal scrolling (WCAG 1.4.10 Reflow)."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "1.4.10",
                    "name": "Reflow",
                    "level": "AA",
                    "version": "2.1",
                    "principle": "perceivable"
                  }
                ],
                "severity": "serious",
                "confidence": "likely"
              }
            },
            {
              "id": "focus-visible",
              "name": "Focusable elements should have visible focus indicators",
              "shortDescription": {
                "text": "Takes before/after focus screenshots to verify that focusable elements have a visible focus indicator, not just a CSS outline check."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "2.4.7",
                    "name": "Focus Visible",
                    "level": "AA",
                    "version": "2.0",
                    "principle": "operable"
                  }
                ],
                "severity": "serious",
                "confidence": "likely"
              }
            },
            {
              "id": "focus-order",
              "name": "Focus order should follow visual layout",
              "shortDescription": {
                "text": "Tabs through focusable elements and verifies that the focus order follows a logical top-to-bottom, left-to-right visual sequence."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "2.4.3",
                    "name": "Focus Order",
                    "level": "A",
                    "version": "2.0",
                    "principle": "operable"
                  }
                ],
                "severity": "serious",
                "confidence": "likely"
              }
            },
            {
              "id": "focus-not-obscured",
              "name": "Focused elements must not be fully obscured",
              "shortDescription": {
                "text": "Checks that focused interactive elements are not hidden behind fixed/sticky positioned elements."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "2.4.11",
                    "name": "Focus Not Obscured (Minimum)",
                    "level": "AA",
                    "version": "2.2",
                    "principle": "operable"
                  }
                ],
                "severity": "serious",
                "confidence": "likely"
              }
            },
            {
              "id": "focus-appearance",
              "name": "Focus indicators must be clearly visible",
              "shortDescription": {
                "text": "Takes before/after focus screenshots and verifies focus indicators change enough pixels to meet WCAG 2.4.13 area requirements."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "2.4.13",
                    "name": "Focus Appearance",
                    "level": "AAA",
                    "version": "2.2",
                    "principle": "operable"
                  }
                ],
                "severity": "moderate",
                "confidence": "likely"
              }
            },
            {
              "id": "landmark-main",
              "name": "Page must have exactly one main landmark",
              "shortDescription": {
                "text": "Ensures the page contains exactly one <main> or [role=\"main\"] landmark. Zero is a violation, multiple produces a warning."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "1.3.1",
                    "name": "Info and Relationships",
                    "level": "A",
                    "version": "2.0",
                    "principle": "perceivable"
                  }
                ],
                "severity": "moderate",
                "confidence": "certain"
              }
            },
            {
              "id": "page-has-heading-one",
              "name": "Page must contain a level-one heading",
              "shortDescription": {
                "text": "Ensures the page has at least one <h1> or an element with [role=\"heading\"][aria-level=\"1\"]."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "1.3.1",
                    "name": "Info and Relationships",
                    "level": "A",
                    "version": "2.0",
                    "principle": "perceivable"
                  }
                ],
                "severity": "moderate",
                "confidence": "certain"
              }
            },
            {
              "id": "bypass",
              "name": "Page must provide a mechanism to bypass repeated blocks of content",
              "shortDescription": {
                "text": "Ensures the page has a skip link, <main> landmark, or [role=\"main\"] to allow users to bypass repeated content."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "2.4.1",
                    "name": "Bypass Blocks",
                    "level": "A",
                    "version": "2.0",
                    "principle": "operable"
                  }
                ],
                "severity": "serious",
                "confidence": "likely"
              }
            },
            {
              "id": "dragging-movements",
              "name": "Dragging functionality must have single-pointer alternatives",
              "shortDescription": {
                "text": "Checks for draggable elements that may lack single-pointer alternatives."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "2.5.7",
                    "name": "Dragging Movements",
                    "level": "AA",
                    "version": "2.2",
                    "principle": "operable"
                  }
                ],
                "severity": "moderate",
                "confidence": "possible"
              }
            },
            {
              "id": "nested-interactive",
              "name": "Interactive elements must not be nested",
              "shortDescription": {
                "text": "Ensures interactive elements (links, buttons, inputs, etc.) are not nested inside other interactive elements."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "4.1.2",
                    "name": "Name, Role, Value",
                    "level": "A",
                    "version": "2.0",
                    "principle": "robust"
                  }
                ],
                "severity": "serious",
                "confidence": "certain"
              }
            },
            {
              "id": "consistent-help",
              "name": "Help mechanisms should be available",
              "shortDescription": {
                "text": "Checks if the page provides help mechanisms like contact info, help links, or chat widgets."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "3.2.6",
                    "name": "Consistent Help",
                    "level": "A",
                    "version": "2.2",
                    "principle": "understandable"
                  }
                ],
                "severity": "moderate",
                "confidence": "possible"
              }
            },
            {
              "id": "lang-mismatch",
              "name": "Page language should match actual content language",
              "shortDescription": {
                "text": "Detects when the declared lang attribute does not match the actual language of the page text content."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "3.1.1",
                    "name": "Language of Page",
                    "level": "A",
                    "version": "2.0",
                    "principle": "understandable"
                  }
                ],
                "tags": [
                  "semantic",
                  "heuristic"
                ],
                "severity": "serious",
                "confidence": "likely"
              }
            },
            {
              "id": "presentation-role-on-semantic",
              "name": "Semantic elements must not have role=\"presentation\" or role=\"none\"",
              "shortDescription": {
                "text": "Detects role=\"presentation\" or role=\"none\" on semantically meaningful HTML elements, which strips their accessibility semantics."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "1.3.1",
                    "name": "Info and Relationships",
                    "level": "A",
                    "version": "2.0",
                    "principle": "perceivable"
                  }
                ],
                "severity": "serious",
                "confidence": "certain"
              }
            },
            {
              "id": "target-size",
              "name": "Interactive targets must have a minimum size",
              "shortDescription": {
                "text": "Ensures interactive targets have a minimum size of 24x24 CSS pixels or sufficient spacing (WCAG 2.2 Success Criterion 2.5.8 Target Size (Minimum))."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "2.5.8",
                    "name": "Target Size (Minimum)",
                    "level": "AA",
                    "version": "2.2",
                    "principle": "operable"
                  }
                ],
                "severity": "moderate",
                "confidence": "likely"
              }
            },
            {
              "id": "tabindex-removes-focusability",
              "name": "Natively focusable elements should not have tabindex=\"-1\"",
              "shortDescription": {
                "text": "Detects natively focusable elements (links, buttons, form controls) that have tabindex=\"-1\", which removes them from the keyboard tab order."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "2.1.1",
                    "name": "Keyboard",
                    "level": "A",
                    "version": "2.0",
                    "principle": "operable"
                  }
                ],
                "severity": "serious",
                "confidence": "likely"
              }
            }
          ]
        }
      },
