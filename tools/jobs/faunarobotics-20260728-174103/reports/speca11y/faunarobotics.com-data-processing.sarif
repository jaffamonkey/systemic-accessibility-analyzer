{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "SpecA11y",
          "version": "0.5.2",
          "informationUri": "https://github.com/OKlueck/SpecA11y",
          "rules": [
            {
              "id": "color-contrast",
              "name": "Elements must have sufficient color contrast",
              "shortDescription": {
                "text": "Ensures text elements have at least a 4.5:1 contrast ratio (3:1 for large text)."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "1.4.3",
                    "name": "Contrast (Minimum)",
                    "level": "AA",
                    "version": "2.0",
                    "principle": "perceivable"
                  }
                ],
                "severity": "serious",
                "confidence": "likely"
              }
            },
            {
              "id": "use-of-color",
              "name": "Color must not be the only visual means of conveying information",
              "shortDescription": {
                "text": "Checks that links and interactive elements are distinguishable from surrounding text by more than just color (e.g. underline, font-weight, border)."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "1.4.1",
                    "name": "Use of Color",
                    "level": "A",
                    "version": "2.0",
                    "principle": "perceivable"
                  }
                ],
                "severity": "moderate",
                "confidence": "possible"
              }
            },
            {
              "id": "landmark-main",
              "name": "Page must have exactly one main landmark",
              "shortDescription": {
                "text": "Ensures the page contains exactly one <main> or [role=\"main\"] landmark. Zero is a violation, multiple produces a warning."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "1.3.1",
                    "name": "Info and Relationships",
                    "level": "A",
                    "version": "2.0",
                    "principle": "perceivable"
                  }
                ],
                "severity": "moderate",
                "confidence": "certain"
              }
            },
            {
              "id": "bypass",
              "name": "Page must provide a mechanism to bypass repeated blocks of content",
              "shortDescription": {
                "text": "Ensures the page has a skip link, <main> landmark, or [role=\"main\"] to allow users to bypass repeated content."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "2.4.1",
                    "name": "Bypass Blocks",
                    "level": "A",
                    "version": "2.0",
                    "principle": "operable"
                  }
                ],
                "severity": "serious",
                "confidence": "likely"
              }
            },
            {
              "id": "multiple-ways",
              "name": "Page should provide multiple ways to locate content",
              "shortDescription": {
                "text": "Checks that the page provides at least one of: navigation landmark, search functionality, sitemap link, or table of contents."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "2.4.5",
                    "name": "Multiple Ways",
                    "level": "AA",
                    "version": "2.0",
                    "principle": "operable"
                  }
                ],
                "severity": "moderate",
                "confidence": "possible"
              }
            },
            {
              "id": "skip-link",
              "name": "Page should have a skip navigation link",
              "shortDescription": {
                "text": "Checks if the page has a skip navigation link among the first few focusable elements that points to the main content area."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "2.4.1",
                    "name": "Bypass Blocks",
                    "level": "A",
                    "version": "2.0",
                    "principle": "operable"
                  }
                ],
                "severity": "moderate",
                "confidence": "possible"
              }
            },
            {
              "id": "pointer-interaction-blocked",
              "name": "Content areas must not block pointer interaction",
              "shortDescription": {
                "text": "Detects pointer-events: none and cursor: none on content areas that would prevent mouse/touch interaction."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "2.5.1",
                    "name": "Pointer Gestures",
                    "level": "A",
                    "version": "2.1",
                    "principle": "operable"
                  }
                ],
                "severity": "critical",
                "confidence": "certain"
              }
            },
            {
              "id": "button-name",
              "name": "Buttons must have accessible names",
              "shortDescription": {
                "text": "Ensures every <button> and [role=\"button\"] element has an accessible name via text content, aria-label, aria-labelledby, title, or value."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "4.1.2",
                    "name": "Name, Role, Value",
                    "level": "A",
                    "version": "2.0",
                    "principle": "robust"
                  }
                ],
                "severity": "critical",
                "confidence": "certain"
              }
            },
            {
              "id": "consistent-navigation",
              "name": "Navigation elements should have consistent structure",
              "shortDescription": {
                "text": "Checks that nav elements use a consistent list-based structure with links, which supports predictable navigation for assistive technology users."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "3.2.3",
                    "name": "Consistent Navigation",
                    "level": "AA",
                    "version": "2.0",
                    "principle": "understandable"
                  }
                ],
                "severity": "moderate",
                "confidence": "possible"
              }
            },
            {
              "id": "aria-required-children",
              "name": "ARIA roles must contain required children",
              "shortDescription": {
                "text": "Ensures elements with ARIA roles that require specific child roles contain at least one child with one of those roles."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "1.3.1",
                    "name": "Info and Relationships",
                    "level": "A",
                    "version": "2.0",
                    "principle": "perceivable"
                  }
                ],
                "severity": "serious",
                "confidence": "certain"
              }
            },
            {
              "id": "reflow",
              "name": "Content must reflow without horizontal scrolling at 320px width",
              "shortDescription": {
                "text": "Resizes the viewport to 320px and checks for elements that cause horizontal scrolling (WCAG 1.4.10 Reflow)."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "1.4.10",
                    "name": "Reflow",
                    "level": "AA",
                    "version": "2.1",
                    "principle": "perceivable"
                  }
                ],
                "severity": "serious",
                "confidence": "likely"
              }
            },
            {
              "id": "focus-visible",
              "name": "Focusable elements should have visible focus indicators",
              "shortDescription": {
                "text": "Takes before/after focus screenshots to verify that focusable elements have a visible focus indicator, not just a CSS outline check."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "2.4.7",
                    "name": "Focus Visible",
                    "level": "AA",
                    "version": "2.0",
                    "principle": "operable"
                  }
                ],
                "severity": "serious",
                "confidence": "likely"
              }
            },
            {
              "id": "focus-order",
              "name": "Focus order should follow visual layout",
              "shortDescription": {
                "text": "Tabs through focusable elements and verifies that the focus order follows a logical top-to-bottom, left-to-right visual sequence."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "2.4.3",
                    "name": "Focus Order",
                    "level": "A",
                    "version": "2.0",
                    "principle": "operable"
                  }
                ],
                "severity": "serious",
                "confidence": "likely"
              }
            },
            {
              "id": "focus-not-obscured",
              "name": "Focused elements must not be fully obscured",
              "shortDescription": {
                "text": "Checks that focused interactive elements are not hidden behind fixed/sticky positioned elements."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "2.4.11",
                    "name": "Focus Not Obscured (Minimum)",
                    "level": "AA",
                    "version": "2.2",
                    "principle": "operable"
                  }
                ],
                "severity": "serious",
                "confidence": "likely"
              }
            },
            {
              "id": "focus-appearance",
              "name": "Focus indicators must be clearly visible",
              "shortDescription": {
                "text": "Takes before/after focus screenshots and verifies focus indicators change enough pixels to meet WCAG 2.4.13 area requirements."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "2.4.13",
                    "name": "Focus Appearance",
                    "level": "AAA",
                    "version": "2.2",
                    "principle": "operable"
                  }
                ],
                "severity": "moderate",
                "confidence": "likely"
              }
            }
          ]
        }
      },
