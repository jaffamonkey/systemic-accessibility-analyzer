        },
        {
          "ruleId": "label-content-name-mismatch",
          "ruleIndex": 10,
          "level": "error",
          "message": {
            "text": "Visible text \"Specialist supportPractical accessibility support for teams building web productsWCAG-informed support across design, development and testing, with a focus on real user journeys, keyboard behaviour, semantics, forms, errors and clear next steps. This can include early design input, support during delivery, and help turning accessibility findings into practical improvements.Specialist supportsAccessibility auditClear accessibility reviews without the theatreFocused accessibility reviews that combine automated checks, manual investigation and practical remediation guidance for developers, designers, testers and product teams. The aim is to identify meaningful barriers, explain their impact clearly, and help teams understand what to fix first.Accessibility audit\" is not part of the accessible name \"Accessibility service summary\". The accessible name must contain the visible text for speech input users."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "section.mt-8.w-full > div.hct-core-home.hct-accessibility-only-home > section.hct-feature-stack.hct-service-feature-stack:nth-of-type(2)"
                }
              ],
              "message": {
                "text": "<section class=\"hct-feature-stack hct-service-feature-stack\" aria-label=\"Accessibility service summary\"><article class=\"hct-feature-row hct-feature-row-specialist\"><div class=\"hct-feature-copy\"><p class=\"hct-core-kicker\">Specialist support</p><h2>Practical accessibility support for teams building web products</h2><p>WCAG-informed support across design, development and testing, with a focus on real user journeys, keyboard behaviour, semantics, forms, errors and clear next steps. This can include early design input, support during delivery, and help turning accessibility findings into practical improvements.</p><a class=\"hct-core-button hct-core-button-secondary\" href=\"/accessibility-specialist/\">Specialist support</a></div><figure class=\"hct-feature-image\"><img src=\"/images/accessibility-support.png\" alt=\"Illustration or screenshot representing accessibility specialist support.\" loading=\"lazy\" decoding=\"async\" class=\"medium-zoom-image\"></figure>s</article><article class=\"hct-feature-row hct-feature-row-audit\"><div class=\"hct-feature-copy\"><p class=\"hct-core-kicker\">Accessibility audit</p><h2>Clear accessibility reviews without the theatre</h2><p>Focused accessibility reviews that combine automated checks, manual investigation and practical remediation guidance for developers, designers, testers and product teams. The aim is to identify meaningful barriers, explain their impact clearly, and help teams understand what to fix first.</p><a class=\"hct-core-button hct-core-button-secondary\" href=\"/audit-services/\">Accessibility audit</a></div><figure class=\"hct-feature-image\"><img src=\"/images/accessibility-audit.png\" alt=\"Illustration or screenshot representing accessibility audit.\" loading=\"lazy\" decoding=\"async\" class=\"medium-zoom-image\"></figure></article></section> | Accessible name: \"Accessibility service summary\""
              }
            }
          ]
        },
        {
          "ruleId": "label-content-name-mismatch",
          "ruleIndex": 10,
          "level": "error",
          "message": {
            "text": "Visible text \"Systemic Accessibility AnalyzerFor when accessibility reports get too big to triage page by page.The analyzer groups multi-tool output into repeated patterns, cross-tool evidence and fix-once benefit-many views, helping teams focus on shared causes instead of drowning in page-level findings.Systemic Accessibility Analyzer\" is not part of the accessible name \"Systemic Accessibility Analyzer\". The accessible name must contain the visible text for speech input users."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "section.mt-8.w-full > div.hct-core-home.hct-accessibility-only-home > section.hct-feature-stack.hct-analyzer-feature-stack:nth-of-type(3)"
                }
              ],
              "message": {
                "text": "<section class=\"hct-feature-stack hct-analyzer-feature-stack\" aria-label=\"Systemic Accessibility Analyzer\"><article class=\"hct-feature-row hct-feature-row-analyzer\"><div class=\"hct-feature-copy\"><p class=\"hct-core-kicker\">Systemic Accessibility Analyzer</p><h2>For when accessibility reports get too big to triage page by page.</h2><p>The analyzer groups multi-tool output into repeated patterns, cross-tool evidence and fix-once benefit-many views, helping teams focus on shared causes instead of drowning in page-level findings.</p><nav class=\"hct-feature-links\" aria-label=\"Analyzer guide links\"><a class=\"hct-core-button hct-core-button-secondary\" href=\"/analyzer/\">Systemic Accessibility Analyzer</a></nav></div><figure class=\"hct-feature-image hct-feature-image-analyzer\"><img src=\"/images/accessibility-systemic-analyzer-collage.png\" alt=\"COMING SOON. Collage of Systemic Accessibility Analyzer dashboard, contrast report, tab order map, virtual screenreader output and screenshot gallery.\" loading=\"lazy\" decoding=\"async\" class=\"medium-zoom-image\"></figure></article></section> | Accessible name: \"Systemic Accessibility Analyzer\""
              }
            }
          ]
        },
