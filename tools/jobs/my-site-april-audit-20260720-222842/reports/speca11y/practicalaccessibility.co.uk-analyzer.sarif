{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "SpecA11y",
          "version": "0.5.2",
          "informationUri": "https://github.com/OKlueck/SpecA11y",
          "rules": [
            {
              "id": "color-contrast",
              "name": "Elements must have sufficient color contrast",
              "shortDescription": {
                "text": "Ensures text elements have at least a 4.5:1 contrast ratio (3:1 for large text)."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "1.4.3",
                    "name": "Contrast (Minimum)",
                    "level": "AA",
                    "version": "2.0",
                    "principle": "perceivable"
                  }
                ],
                "severity": "serious",
                "confidence": "likely"
              }
            },
            {
              "id": "content-on-hover-focus",
              "name": "Hover/focus triggered content must be dismissible and persistent",
              "shortDescription": {
                "text": "Heuristic check for content that appears on hover only, such as title attributes on non-interactive elements which create native tooltips that cannot be dismissed or hovered over."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "1.4.13",
                    "name": "Content on Hover or Focus",
                    "level": "AA",
                    "version": "2.1",
                    "principle": "perceivable"
                  }
                ],
                "severity": "moderate",
                "confidence": "possible"
              }
            },
            {
              "id": "landmark-banner-top-level",
              "name": "Banner landmark must be top level",
              "shortDescription": {
                "text": "Ensures <header> (acting as banner) and [role=\"banner\"] elements are not nested inside sectioning landmarks."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "1.3.1",
                    "name": "Info and Relationships",
                    "level": "A",
                    "version": "2.0",
                    "principle": "perceivable"
                  }
                ],
                "severity": "moderate",
                "confidence": "certain"
              }
            },
            {
              "id": "landmark-unique",
              "name": "Landmarks must have a unique accessible name when multiple of the same role exist",
              "shortDescription": {
                "text": "When multiple landmarks share the same role, each must have a unique accessible name via aria-label or aria-labelledby."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "1.3.1",
                    "name": "Info and Relationships",
                    "level": "A",
                    "version": "2.0",
                    "principle": "perceivable"
                  }
                ],
                "severity": "moderate",
                "confidence": "likely"
              }
            },
            {
              "id": "css-content-visibility",
              "name": "Content must not be made invisible via CSS tricks",
              "shortDescription": {
                "text": "Detects CSS properties that make content invisible while keeping it in the DOM: filter opacity below threshold, font-size below 4px, transform scale(0), or clip-path hiding."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "1.4.3",
                    "name": "Contrast (Minimum)",
                    "level": "AA",
                    "version": "2.0",
                    "principle": "perceivable"
                  },
                  {
                    "id": "1.4.4",
                    "name": "Resize Text",
                    "level": "AA",
                    "version": "2.0",
                    "principle": "perceivable"
                  }
                ],
                "severity": "critical",
                "confidence": "certain"
              }
            },
            {
              "id": "transparent-content",
              "name": "Text must not be made invisible via transparent color, low opacity, or extreme spacing",
              "shortDescription": {
                "text": "Detects text elements with color: transparent, rgba with alpha 0, low effective opacity (CSS opacity or filter: opacity()), or extremely negative letter-spacing/word-spacing that makes text unreadable."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "1.4.3",
                    "name": "Contrast (Minimum)",
                    "level": "AA",
                    "version": "2.0",
                    "principle": "perceivable"
                  }
                ],
                "severity": "critical",
                "confidence": "certain"
              }
            },
            {
              "id": "link-name",
              "name": "Links must have discernible text",
              "shortDescription": {
                "text": "Ensures every <a> element has accessible text that describes its purpose."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "2.4.4",
                    "name": "Link Purpose (In Context)",
                    "level": "A",
                    "version": "2.0",
                    "principle": "operable"
                  }
                ],
                "severity": "serious",
                "confidence": "certain"
              }
            },
            {
              "id": "target-size",
              "name": "Interactive targets must have a minimum size",
              "shortDescription": {
                "text": "Ensures interactive targets have a minimum size of 24x24 CSS pixels or sufficient spacing (WCAG 2.2 Success Criterion 2.5.8 Target Size (Minimum))."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "2.5.8",
                    "name": "Target Size (Minimum)",
                    "level": "AA",
                    "version": "2.2",
                    "principle": "operable"
                  }
                ],
                "severity": "moderate",
                "confidence": "likely"
              }
            },
            {
              "id": "nested-interactive",
              "name": "Interactive elements must not be nested",
              "shortDescription": {
                "text": "Ensures interactive elements (links, buttons, inputs, etc.) are not nested inside other interactive elements."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "4.1.2",
                    "name": "Name, Role, Value",
                    "level": "A",
                    "version": "2.0",
                    "principle": "robust"
                  }
                ],
                "severity": "serious",
                "confidence": "certain"
              }
            },
            {
              "id": "no-empty-links",
              "name": "Links must have discernible text",
              "shortDescription": {
                "text": "Ensures that all links (<a href>) have discernible text via text content, aria-label, aria-labelledby, or child img alt text."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "2.4.4",
                    "name": "Link Purpose (In Context)",
                    "level": "A",
                    "version": "2.0",
                    "principle": "operable"
                  }
                ],
                "tags": [
                  "best-practice"
                ],
                "severity": "serious",
                "confidence": "certain"
              }
            },
            {
              "id": "form-field-multiple-labels",
              "name": "Form fields should not have multiple labels",
              "shortDescription": {
                "text": "Ensures form fields do not have multiple <label> elements pointing to the same ID, which can cause confusion for assistive technologies."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "3.3.2",
                    "name": "Labels or Instructions",
                    "level": "A",
                    "version": "2.0",
                    "principle": "understandable"
                  }
                ],
                "severity": "moderate",
                "confidence": "certain"
              }
            },
            {
              "id": "consistent-navigation",
              "name": "Navigation elements should have consistent structure",
              "shortDescription": {
                "text": "Checks that nav elements use a consistent list-based structure with links, which supports predictable navigation for assistive technology users."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "3.2.3",
                    "name": "Consistent Navigation",
                    "level": "AA",
                    "version": "2.0",
                    "principle": "understandable"
                  }
                ],
                "severity": "moderate",
                "confidence": "possible"
              }
            },
            {
              "id": "label-content-name-mismatch",
              "name": "Visible text must be part of the accessible name",
              "shortDescription": {
                "text": "Elements with both visible text and an accessible name (via aria-label) must include the visible text as part of the accessible name, per WCAG 2.5.3 Label in Name."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "2.5.3",
                    "name": "Label in Name",
                    "level": "A",
                    "version": "2.1",
                    "principle": "operable"
                  }
                ],
                "tags": [
                  "experimental"
                ],
                "severity": "serious",
                "confidence": "likely"
              }
            },
            {
              "id": "duplicate-id",
              "name": "ID attributes must be unique",
              "shortDescription": {
                "text": "Ensures every id attribute value on the page is unique."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "4.1.1",
                    "name": "Parsing",
                    "level": "A",
                    "version": "2.0",
                    "principle": "robust"
                  }
                ],
                "severity": "serious",
                "confidence": "certain"
              }
            },
            {
              "id": "non-text-contrast",
              "name": "UI components must have sufficient non-text contrast",
              "shortDescription": {
                "text": "Ensures visual boundaries of UI components (inputs, buttons, checkboxes) have at least 3:1 contrast ratio against adjacent colors."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "1.4.11",
                    "name": "Non-text Contrast",
                    "level": "AA",
                    "version": "2.1",
                    "principle": "perceivable"
                  }
                ],
                "severity": "serious",
                "confidence": "likely"
              }
            },
            {
              "id": "text-spacing",
              "name": "Content must not be clipped when text spacing is increased",
              "shortDescription": {
                "text": "Injects WCAG 1.4.12 text spacing overrides and checks for text overflow or clipping."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "1.4.12",
                    "name": "Text Spacing",
                    "level": "AA",
                    "version": "2.1",
                    "principle": "perceivable"
                  }
                ],
                "severity": "serious",
                "confidence": "likely"
              }
            },
            {
              "id": "focus-visible",
              "name": "Focusable elements should have visible focus indicators",
              "shortDescription": {
                "text": "Takes before/after focus screenshots to verify that focusable elements have a visible focus indicator, not just a CSS outline check."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "2.4.7",
                    "name": "Focus Visible",
                    "level": "AA",
                    "version": "2.0",
                    "principle": "operable"
                  }
                ],
                "severity": "serious",
                "confidence": "likely"
              }
            },
            {
              "id": "focus-order",
              "name": "Focus order should follow visual layout",
              "shortDescription": {
                "text": "Tabs through focusable elements and verifies that the focus order follows a logical top-to-bottom, left-to-right visual sequence."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "2.4.3",
                    "name": "Focus Order",
                    "level": "A",
                    "version": "2.0",
                    "principle": "operable"
                  }
                ],
                "severity": "serious",
                "confidence": "likely"
              }
            },
            {
              "id": "focus-not-obscured",
              "name": "Focused elements must not be fully obscured",
              "shortDescription": {
                "text": "Checks that focused interactive elements are not hidden behind fixed/sticky positioned elements."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "2.4.11",
                    "name": "Focus Not Obscured (Minimum)",
                    "level": "AA",
                    "version": "2.2",
                    "principle": "operable"
                  }
                ],
                "severity": "serious",
                "confidence": "likely"
              }
            },
            {
              "id": "focus-appearance",
              "name": "Focus indicators must be clearly visible",
              "shortDescription": {
                "text": "Takes before/after focus screenshots and verifies focus indicators change enough pixels to meet WCAG 2.4.13 area requirements."
              },
              "properties": {
                "wcagCriteria": [
                  {
                    "id": "2.4.13",
                    "name": "Focus Appearance",
                    "level": "AAA",
                    "version": "2.2",
                    "principle": "operable"
                  }
                ],
                "severity": "moderate",
                "confidence": "likely"
              }
            }
          ]
        }
      },
